plot_camera_barplot <- function(
    res,
    title,
    top_n = 15
) {

  if (nrow(res) == 0) {

    cat(
      "No significant GO terms for",
      title,
      "-- skipping plot.\n"
    )

    return(
      invisible(NULL)
    )
  }

  res_top <- head(
    res[
      order(res$FDR),
    ],
    top_n
  )

  res_top$TERM <- factor(
    res_top$TERM,
    levels = rev(res_top$TERM)
  )

  p <- ggplot(
    res_top,
    aes(
      x = TERM,
      y = -log10(FDR),
      fill = Direction
    )
  ) +
    geom_col() +
    coord_flip() +
    scale_fill_manual(
      values = c(
        Up = "firebrick",
        Down = "steelblue"
      )
    ) +
    labs(
      title = title,
      x = "GO term",
      y = "-log10(FDR)"
    ) +
    theme_bw()

  print(p)

  ggsave(
    paste0(
      outpathcount,
      "barplot_",
      title,
      ".pdf"
    ),
    p,
    width = 8,
    height = 6
  )
}


