    res_sub$cultivar <- cv
    res_sub
  }))

  term_labels <- unique(comparison_df[, c("GOID", "TERM")])
  full_comparison <- merge(full_comparison, term_labels, by = "GOID", suffixes = c("", "_label"))

  p_comparison <- ggplot(full_comparison, aes(x = cultivar, y = TERM_label, size = NGenes,
