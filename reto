get_sig_genes_direction <- function(res, padj_cutoff = 0.05, lfc_cutoff = 0) {
  df <- as.data.frame(res)
  list(
    Up = rownames(df)[!is.na(df$padj) & df$padj < padj_cutoff & df$log2FoldChange >= lfc_cutoff],
    Down = rownames(df)[!is.na(df$padj) & df$padj < padj_cutoff & df$log2FoldChange <= -lfc_cutoff]
  )
}

