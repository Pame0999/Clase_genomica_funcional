# ============================================================
# Heatmaps (per cultivar)
# ============================================================

plot_heatmap <- function(
    cv,
    top_n = 50
) {

  metadata_cv <- metadata[
    metadata$cultivar == cv,
  ]

  metadata_cv$treatment <- factor(
    metadata_cv$treatment,
    levels = c(
      "saline",
      "xylella"
    )
  )

  counts_cv <- counts[
    ,
    metadata_cv$sample,
    drop = FALSE
  ]

  res <- as.data.frame(
    deseq_results[[cv]]
  )

  sig <- res[
    !is.na(res$padj) &
      res$padj < 0.05 &
      abs(res$log2FoldChange) >= 1,
  ]

  sig <- sig[
    order(sig$padj),
  ]

  if (nrow(sig) == 0) {
    cat(
      "No significant genes for",
      cv,
      "\n"
    )
    return()
  }

  genes <- rownames(sig)[
    1:min(
      top_n,
      nrow(sig)
    )
  ]

  dds <- DESeqDataSetFromMatrix(
    countData = counts_cv,
    colData = metadata_cv,
    design = ~ treatment
  )

  dds <- estimateSizeFactors(dds)

  vsd <- vst(
    dds,
    blind = FALSE
  )

  mat <- assay(vsd)[
    genes,
    ,
    drop = FALSE
  ]

  mat <- t(
    scale(
      t(mat)
    )
  )

  annotation_col <- data.frame(
    Treatment = metadata_cv$treatment
  )

  rownames(annotation_col) <- metadata_cv$sample

  colnames(mat) <- metadata_cv$sample

  pdf(
    paste0(
      outpathcount,
      "Heatmap_",
      cv,
      ".pdf"
    ),
    width = 9,
    height = 10
  )

  pheatmap(
    mat,
    cluster_rows = TRUE,
    cluster_cols = TRUE,
    show_rownames = TRUE,
    annotation_col = annotation_col,
    main = paste(
      "Top DE genes -",
      cv
    ),
    fontsize_row = 7
  )

  dev.off()

  cat(
    "Heatmap saved for",
    cv,
    "-",
    length(genes),
    "genes\n"
  )
}

