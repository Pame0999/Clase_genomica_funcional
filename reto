# ============================================================
# CAMERA analysis per cultivar
# ============================================================

cultivars <- c(
  "Catuai",
  "CR95"
)

camera_results <- list()

voom_objects <- list()


for (cv in cultivars) {

  cat(
    "=== Running CAMERA for",
    cv,
    "===\n"
  )

  # Select samples from current cultivar

  metadata_cv <- metadata[
    metadata$cultivar == cv,
  ]

  counts_cv <- counts[
    ,
    metadata_cv$sample,
    drop = FALSE
  ]

  # Treatment

  treatment <- factor(
    metadata_cv$treatment,
    levels = c(
      "saline",
      "xylella"
    )
  )

  # DGEList

  dge <- DGEList(
    counts = counts_cv,
    group = treatment
  )

  # Filter low-expression genes

  keep <- filterByExpr(
    dge,
    group = treatment
  )

  dge <- dge[
    keep,
    ,
    keep.lib.sizes = FALSE
  ]

  # Normalize

  dge <- calcNormFactors(dge)

  # Design

  design <- model.matrix(
    ~ treatment
  )

  # Voom

  v <- voom(
    dge,
    design,
    plot = FALSE
  )

  voom_objects[[cv]] <- v

  # Restrict GO sets to genes present
  # in filtered expression data

  term2gene_cv <- lapply(
    term2gene,
    function(g) {
      intersect(
        g,
        rownames(v$E)
      )
    }
  )

  # Keep GO terms with >= 5 genes

  term2gene_cv <- term2gene_cv[
    lengths(term2gene_cv) >= min_set_size
  ]

  cat(
    "GO terms available for",
    cv,
    ":",
    length(term2gene_cv),
    "\n"
  )

  if (length(term2gene_cv) == 0) {

    warning(
      "No GO terms available for ",
      cv
    )

    next
  }

  # Convert GO sets to row indices

  idx <- lapply(
    term2gene_cv,
    function(g) {
      match(
        g,
        rownames(v$E)
      )
    }
  )

  # CAMERA

  res <- camera(
    v,
    index = idx,
    design = design,
    contrast = 2
  )

  res$GOID <- rownames(res)

  # GO information

  term_info <- suppressMessages(
    AnnotationDbi::select(
      GO.db,
      keys = res$GOID,
      columns = c(
        "TERM",
        "ONTOLOGY"
      ),
      keytype = "GOID"
    )
  )

  res <- merge(
    res,
    term_info,
    by = "GOID",
    all.x = TRUE
  )

  res$TERM[
    is.na(res$TERM)
  ] <- res$GOID[
    is.na(res$TERM)
  ]

  res$ONTOLOGY[
    is.na(res$ONTOLOGY)
  ] <- "Unknown"

  res <- res[
    order(res$PValue),
  ]

  camera_results[[cv]] <- res

  # Save CAMERA results

  write.table(
    res,
    file = paste0(
      outpathcount,
      "CAMERA_",
      cv,
      ".txt"
    ),
    row.names = FALSE,
    col.names = TRUE,
    quote = FALSE,
    sep = "\t"
  )
}


