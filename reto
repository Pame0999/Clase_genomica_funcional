deseq_results <- list()

for (cv in cultivars) {

  cat("\n========================================\n")
  cat("Running DESeq2 for:", cv, "\n")
  cat("========================================\n")

  # ----------------------------------------------------------
  # Select samples from cultivar
  # ----------------------------------------------------------

  metadata_cv <- metadata[
    metadata$cultivar == cv,
    ,
    drop = FALSE
  ]

  cat(
    "Samples:",
    paste(metadata_cv$sample, collapse = ", "),
    "\n"
  )

  # ----------------------------------------------------------
  # Counts
  # ----------------------------------------------------------

  counts_cv <- counts[
    ,
    metadata_cv$sample,
    drop = FALSE
  ]

  # ----------------------------------------------------------
  # Treatment
  # ----------------------------------------------------------

  metadata_cv$treatment <- factor(
    metadata_cv$treatment,
    levels = c(
      "saline",
      "xylella"
    )
  )

  print(table(metadata_cv$treatment))

  # ----------------------------------------------------------
  # Remove genes with zero counts in all samples
  # ----------------------------------------------------------

  counts_cv <- counts_cv[
    rowSums(counts_cv) > 0,
    ,
    drop = FALSE
  ]

  # ----------------------------------------------------------
  # DESeq2 object
  # ----------------------------------------------------------

  dds <- DESeqDataSetFromMatrix(
    countData = counts_cv,
    colData = metadata_cv,
    design = ~ treatment
  )

  dds <- DESeq(dds)

  # ----------------------------------------------------------
  # Xylella vs saline
  # ----------------------------------------------------------

  res <- results(
    dds,
    contrast = c(
      "treatment",
      "xylella",
      "saline"
    )
  )

  res <- as.data.frame(res)

  res <- res[
    order(res$padj),
    ,
    drop = FALSE
  ]

  deseq_results[[cv]] <- res

  cat(
    "Genes analyzed:",
    nrow(res),
    "\n"
  )

  cat(
    "Significant genes FDR < 0.05:",
    sum(
      !is.na(res$padj) &
        res$padj < 0.05
    ),
    "\n"
  )

  # ----------------------------------------------------------
  # Save complete results
  # ----------------------------------------------------------

  write.table(
    res,
    file = paste0(
      outpathcount,
      "DESeq2_",
      cv,
      ".txt"
    ),
    sep = "\t",
    row.names = TRUE,
    col.names = NA,
    quote = FALSE
  )

  # ----------------------------------------------------------
  # Significant genes: FDR < 0.05 AND |log2FC| >= 1
  # ----------------------------------------------------------

  sig <- res[
    !is.na(res$padj) &
      res$padj < 0.05 &
      !is.na(res$log2FoldChange) &
      abs(res$log2FoldChange) >= 1,
    ,
    drop = FALSE
  ]

  write.table(
    sig,
    file = paste0(
      outpathcount,
      "DESeq2_sig_",
      cv,
      ".txt"
    ),
    sep = "\t",
    row.names = TRUE,
    col.names = NA,
    quote = FALSE
  )

  cat(
    "Significant genes FDR < 0.05 and |log2FC| >= 1:",
    nrow(sig),
    "\n"
  )

  # ----------------------------------------------------------
  # Save the DESeqDataSet too, needed later for the heatmap
  # ----------------------------------------------------------

  assign(paste0("dds_", cv), dds)
}


