# ------------------------------------------------------------
# Red de genes hub por modulo (grafo real, no solo texto)
#      Usa la matriz TOM para dibujar los genes mas conectados
#      de cada modulo con igraph.
# ------------------------------------------------------------
 
plot_module_network <- function(mod, top_n = 30, edge_threshold = 0.15) {
 
  genes_module <- colnames(datExpr)[moduleColors == mod]
  if (length(genes_module) < 3) return(invisible(NULL))
 
  mod_index <- which(moduleColors == mod)
  TOM_module <- TOM[mod_index, mod_index]
  dimnames(TOM_module) <- list(genes_module, genes_module)
 
  # conectividad intramodular -> elegir los genes hub
  kIN <- rowSums(TOM_module) - 1
  top_genes <- names(sort(kIN, decreasing = TRUE))[1:min(top_n, length(kIN))]
 
  sub_TOM <- TOM_module[top_genes, top_genes]
  sub_TOM[sub_TOM < edge_threshold] <- 0
  diag(sub_TOM) <- 0
 
  g <- graph_from_adjacency_matrix(sub_TOM, mode = "undirected", weighted = TRUE, diag = FALSE)
  g <- delete_vertices(g, degree(g) == 0)
 
  if (vcount(g) == 0) {
    cat("Sin conexiones suficientes para graficar el modulo", mod, "\n")
    return(invisible(NULL))
  }
 
  pdf(file.path(network_path, paste0("Network_", mod, ".pdf")), width = 8, height = 8)
  plot(
    g,
    vertex.size = 6,
    vertex.label.cex = 0.55,
    vertex.color = mod,
    vertex.label.color = "black",
    edge.width = E(g)$weight * 4,
    edge.color = adjustcolor("grey40", alpha.f = 0.6),
    layout = layout_with_fr(g),
    main = paste("Hub gene network -", mod)
  )
  dev.off()
 
  cat("Red graficada para modulo", mod, "-", vcount(g), "genes,", ecount(g), "conexiones\n")
}
 
